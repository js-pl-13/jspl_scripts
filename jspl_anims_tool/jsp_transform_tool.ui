          <width>45</width>
          <height>25</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>45</width>
          <height>25</height>
         </size>
        </property>
        <property name="text">
         <string>Remove</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>

    <!-- TEMP COPY / PASTE -->
    <item>
     <widget class="QGroupBox" name="grpTemp">
      <property name="title">
       <string>Temporary File</string>
      </property>
      <layout class="QVBoxLayout">
       <!-- Чекбоксы Translate, Rotate, Key All Keyable -->
       <item>
        <layout class="QHBoxLayout">
         <item>
          <widget class="QCheckBox" name="chkRootTranslate">
           <property name="text">
            <string>Translate</string>
           </property>
           <property name="checked">
            <bool>false</bool>
           </property>
           <property name="alignment">
            <set>Qt::AlignVCenter</set>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chkRootRotate">
           <property name="text">
            <string>Rotate</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
           <property name="alignment">
            <set>Qt::AlignVCenter</set>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="chkTempKeyAll">
           <property name="text">
            <string>Key All Keyable</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
           <property name="alignment">
            <set>Qt::AlignVCenter</set>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- Кнопки Copy / Paste -->
       <item>
