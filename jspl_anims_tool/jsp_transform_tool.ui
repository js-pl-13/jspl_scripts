         <item>
          <widget class="QPushButton" name="btnCopyTemp">
           <property name="text">
            <string>Copy</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnPasteTemp">
           <property name="text">
            <string>Paste</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>

